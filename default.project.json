{
	"name": "haywood-valley",
	"globIgnorePaths": [
		"**/package.json",
		"**/tsconfig.json"
	],
	"tree": {
		"$className": "DataModel",
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"TS": {
				"$path": "out/server"
			}
		},
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@flamework": {
						"$path": "node_modules/@flamework"
					}
				}
			},
			"TS": {
				"$path": "out/shared"
			}
		},
		"ReplicatedFirst": {
			"$className": "ReplicatedFirst",
			"Abertura": {
				"$path": "luau/ReplicatedFirst/Abertura.client.luau"
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"TS": {
					"$path": "out/client"
				}
			},
			"StarterCharacterScripts": {
				"$className": "StarterCharacterScripts",
				"Animate": {
					"$path": "luau/StarterCharacterScripts/Animate.client.luau"
				},
				"Health": {
					"$path": "luau/StarterCharacterScripts/Health.server.luau"
				}
			},
			"$properties": {
				"LoadCharacterAppearance": false
			},
			"StarterCharacter": {
				"$className": "Model",
				"$properties": {
					"Attributes": {
						"Rojo_Target_PrimaryPart": { "String": "hv_root" }
					}
				},
				"HumanoidRootPart": {
					"$className": "Part",
					"$properties": {
						"Size": [2, 2, 1],
						"Transparency": 1,
						"CanCollide": true,
						"Attributes": {
							"Rojo_Id": { "String": "hv_root" }
						}
					}
				},
				"Humanoid": {
					"$className": "Humanoid",
					"$properties": {
						"RigType": "R15",
						"HipHeight": 2,
						"DisplayDistanceType": "None"
					}
				}
			}
		},
		"Players": {
			"$className": "Players",
			"$properties": {
				"CharacterAutoLoads": true
			}
		},
		"StarterGui": {
			"$className": "StarterGui",
			"$properties": {
				"ScreenOrientation": "LandscapeSensor"
			}
		},
		"Workspace": {
			"$className": "Workspace",
			"$properties": {
				"FilteringEnabled": true,
				"StreamingEnabled": true,
				"StreamingTargetRadius": 192
			}
		},
		"TextChatService": {
			"$className": "TextChatService",
			"$properties": {
				"ChatVersion": "TextChatService"
			}
		},
		"HttpService": {
			"$className": "HttpService",
			"$properties": {
				"HttpEnabled": true
			}
		},
		"SoundService": {
			"$className": "SoundService",
			"$properties": {
				"RespectFilteringEnabled": true
			}
		}
	}
}

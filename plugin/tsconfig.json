{
	// Projeto do plugin Diorama. É um projeto roblox-ts separado do jogo (sem Flamework), mas usa o mesmo
	// node_modules e o mesmo TypeScript da raiz. Compilar pela raiz: npm run plugin:build.
	"compilerOptions": {
		// obrigatórias pelo roblox-ts
		"allowSyntheticDefaultImports": true,
		"downlevelIteration": true,
		"jsx": "react",
		"jsxFactory": "Vide.jsx",
		"jsxFragmentFactory": "Vide.Fragment",
		"module": "commonjs",
		"moduleResolution": "Node",
		"noLib": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		// O roblox-ts exige que typeRoots contenha <pasta do tsconfig>/node_modules/@rbxts, mesmo que ela não exista;
		// os tipos de verdade vêm do node_modules da raiz.
		"typeRoots": ["../node_modules/@rbxts", "node_modules/@rbxts"],

		// configuráveis
		"rootDir": "src",
		"outDir": "out",
		"incremental": true,
		"tsBuildInfoFile": "out/tsconfig.tsbuildinfo"
	},
	"include": ["src"]
}
